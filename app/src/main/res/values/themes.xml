<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SkillBridge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">#0D47A1</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorSecondaryVariant">#1E7E34</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/toolbar_dark</item>
        <item name="android:navigationBarColor">@color/toolbar_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/screen_bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
    </style>

    <style name="Theme.SkillBridge.Splash" parent="Theme.SkillBridge">
        <item name="android:windowBackground">#080E14</item>
        <item name="android:statusBarColor">#080E14</item>
        <item name="android:navigationBarColor">#080E14</item>
    </style>

    <style name="ToolbarTextTheme" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/always_white</item>
        <item name="android:textColorSecondary">@color/always_white</item>
    </style>

    <style name="GoldBorderCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/brand_gold</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="DynamicIslandDialogStyle" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="IslandAnimation">
        <item name="android:windowEnterAnimation">@anim/island_enter</item>
        <item name="android:windowExitAnimation">@anim/island_exit</item>
    </style>
</resources>